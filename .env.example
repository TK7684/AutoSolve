# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Detection Settings
CHECK_INTERVAL=10  # Seconds between checks
OCR_CONFIDENCE_THRESHOLD=0.7
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# Computer Identification
COMPUTER_NAME=MyComputer

# Model Paths
YOLO_MODEL_PATH=Model/100824-YOLOv8.pt

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/autosolve.log

# Image Settings
MAX_SCREENSHOT_AGE=3600  # Seconds (1 hour)
MAX_SCREENSHOTS_STORED=100
SCREENSHOT_QUALITY=95  # JPEG quality

# Performance Settings
ENABLE_GPU=true  # Use GPU for YOLO if available
MAX_CPU_USAGE=80  # Maximum CPU usage percentage

# Telegram Notification Settings
NOTIFICATION_COOLDOWN=300  # Seconds (5 minutes)
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5  # Seconds

# Monitoring Settings
ENABLE_AUTO_SOLVE=false  # Auto-solving is in development
MONITORING_MODE=247  # 24/7 mode

# Advanced Settings
DEBUG_MODE=false
SAVE_DEBUG_IMAGES=false
PERFORMANCE_MONITORING=true

# Regional Settings
LANGUAGE=en
TIME_ZONE=UTC